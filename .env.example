# Server only. Use a Neon pooled connection URL from Vercel's Neon integration.
# Never prefix it with NEXT_PUBLIC_ or commit a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: integration tests only accept a local database. Do not use production.
# EVALUATION_TEST_DATABASE_URL=postgresql://evaluation_test@127.0.0.1:55432/postgres
